package practice.capgeint;

public class PrimeNumber {

    public static void main(String[] args) {

        int x = 98, factors = 0;
        for(int i = 1;i <= x;i++) {
            if (x % i == 0) {
                factors += 1;
            }
        }

        if(factors > 2) {
            System.out.println("false");
        } else {
            System.out.println("true");
        }
    }
}
